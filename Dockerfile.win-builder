# Build the Windows NSIS installer with Wine (used from Linux CI or Docker Desktop).
FROM electronuserland/builder:20-wine

WORKDIR /project
ENV ELECTRON_CACHE=/root/.cache/electron
ENV ELECTRON_BUILDER_CACHE=/root/.cache/electron-builder

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY electron ./electron
COPY electron-builder.yml ./
COPY nsis ./nsis

# The Docker image tar must already exist at electron/resources/deepwiki-open.tar
# (created by `docker save` on the host or the export-image compose service).
COPY electron/resources ./electron/resources

RUN npx electron-builder --win nsis --publish never
